NODE_ENV=development
DATA_MODE=mysql
API_PORT=4000
WEB_ORIGIN=http://localhost:5175
SESSION_COOKIE_NAME=ascenta_session
CSRF_COOKIE_NAME=ascenta_csrf
SESSION_TTL_HOURS=12
TRUST_PROXY=false
VITE_API_BASE_URL=/api/v1
VITE_CSRF_COOKIE_NAME=ascenta_csrf
# scripts/db-start.ps1 generates local credentials for the dedicated MySQL on 3307.
# To use another MySQL instance, configure both URLs before running migrations.
DATABASE_URL=mysql://ascenta:replace-with-local-password@127.0.0.1:3307/ascenta_local
TEST_DATABASE_URL=mysql://ascenta:replace-with-local-password@127.0.0.1:3307/ascenta_test
