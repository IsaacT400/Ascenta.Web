{
  "name": "@ascenta/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host localhost --port 5175 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host localhost --port 5175 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:visual": "node ../../tests/visual/check-baseline-manifest.mjs"
  },
  "dependencies": {
    "@ascenta/shared": "workspace:*",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.3",
    "vite": "8.0.13"
  }
}