generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  CORPORATE_BOOKER
  CORPORATE_ADMIN
}

enum ReservationStatus {
  DRAFT
  REQUESTED
  QUOTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  ISSUED
  ACCEPTED
  EXPIRED
  SUPERSEDED
}

enum RatePlanType {
  PUBLIC
  CORPORATE
  CONTRACT
}

model User {
  id           String        @id @default(uuid()) @db.Char(36)
  email        String        @unique @db.VarChar(254)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  displayName  String        @map("display_name") @db.VarChar(160)
  status       UserStatus    @default(ACTIVE)
  isAdmin      Boolean       @default(false) @map("is_admin")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  sessions     Session[]
  memberships  Membership[]
  reservations Reservation[] @relation("ReservationCreator")
  auditLogs    AuditLog[]    @relation("AuditActor")

  @@map("users")
}

model Session {
  id            String    @id @default(uuid()) @db.Char(36)
  userId        String    @map("user_id") @db.Char(36)
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash String    @map("csrf_token_hash") @db.Char(64)
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Organization {
  id           String        @id @default(uuid()) @db.Char(36)
  name         String        @db.VarChar(180)
  status       String        @default("ACTIVE") @db.VarChar(32)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  memberships  Membership[]
  reservations Reservation[]
  ratePlans    RatePlan[]

  @@map("organizations")
}

model Membership {
  id             String         @id @default(uuid()) @db.Char(36)
  userId         String         @map("user_id") @db.Char(36)
  organizationId String         @map("organization_id") @db.Char(36)
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@map("memberships")
}

model ServiceType {
  id           String        @id @default(uuid()) @db.Char(36)
  code         String        @unique @db.VarChar(40)
  name         String        @db.VarChar(120)
  isActive     Boolean       @default(true) @map("is_active")
  reservations Reservation[]
  rateRules    PricingRule[]

  @@map("service_types")
}

model VehicleClass {
  id              String        @id @default(uuid()) @db.Char(36)
  code            String        @unique @db.VarChar(40)
  name            String        @db.VarChar(120)
  passengerLimit  Int           @map("passenger_limit")
  luggageLimit    Int           @map("luggage_limit")
  isActive        Boolean       @default(true) @map("is_active")
  reservations    Reservation[]
  rateRules       PricingRule[]

  @@map("vehicle_classes")
}

model Reservation {
  id                   String            @id @default(uuid()) @db.Char(36)
  reference            String            @unique @db.VarChar(24)
  status               ReservationStatus @default(REQUESTED)
  createdById          String            @map("created_by_id") @db.Char(36)
  organizationId       String?           @map("organization_id") @db.Char(36)
  serviceTypeId        String            @map("service_type_id") @db.Char(36)
  vehicleClassId       String            @map("vehicle_class_id") @db.Char(36)
  pickupAddress        String            @map("pickup_address") @db.VarChar(300)
  destinationAddress   String            @map("destination_address") @db.VarChar(300)
  scheduledAtUtc       DateTime          @map("scheduled_at_utc")
  scheduledTimeZone    String            @map("scheduled_time_zone") @db.VarChar(64)
  passengerCount       Int               @map("passenger_count")
  notes                String?           @db.Text
  idempotencyKey       String            @unique @map("idempotency_key") @db.VarChar(128)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  createdBy            User              @relation("ReservationCreator", fields: [createdById], references: [id])
  organization         Organization?     @relation(fields: [organizationId], references: [id])
  serviceType          ServiceType       @relation(fields: [serviceTypeId], references: [id])
  vehicleClass         VehicleClass      @relation(fields: [vehicleClassId], references: [id])
  segments             RideSegment[]
  quotes               Quote[]

  @@index([createdById, scheduledAtUtc])
  @@index([organizationId, scheduledAtUtc])
  @@map("reservations")
}

model RideSegment {
  id                 String      @id @default(uuid()) @db.Char(36)
  reservationId      String      @map("reservation_id") @db.Char(36)
  sequence           Int
  pickupAddress      String      @map("pickup_address") @db.VarChar(300)
  destinationAddress String      @map("destination_address") @db.VarChar(300)
  scheduledAtUtc     DateTime    @map("scheduled_at_utc")
  reservation        Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, sequence])
  @@map("ride_segments")
}

model RatePlan {
  id             String        @id @default(uuid()) @db.Char(36)
  name           String        @db.VarChar(160)
  type           RatePlanType
  organizationId String?       @map("organization_id") @db.Char(36)
  currency       String        @default("USD") @db.Char(3)
  version        Int           @default(1)
  effectiveFrom  DateTime      @map("effective_from")
  effectiveTo    DateTime?     @map("effective_to")
  isActive       Boolean       @default(true) @map("is_active")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  rules          PricingRule[]
  quotes         Quote[]

  @@index([organizationId, isActive])
  @@map("rate_plans")
}

model PricingRule {
  id              String        @id @default(uuid()) @db.Char(36)
  ratePlanId      String        @map("rate_plan_id") @db.Char(36)
  serviceTypeId   String?       @map("service_type_id") @db.Char(36)
  vehicleClassId  String?       @map("vehicle_class_id") @db.Char(36)
  code            String        @unique @db.VarChar(100)
  ruleType        String        @map("rule_type") @db.VarChar(40)
  configuration   Json
  priority        Int           @default(100)
  effectiveFrom   DateTime      @map("effective_from")
  effectiveTo     DateTime?     @map("effective_to")
  isActive        Boolean       @default(true) @map("is_active")
  ratePlan        RatePlan      @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  serviceType     ServiceType?  @relation(fields: [serviceTypeId], references: [id])
  vehicleClass    VehicleClass? @relation(fields: [vehicleClassId], references: [id])

  @@index([ratePlanId, priority, isActive])
  @@map("pricing_rules")
}

model Quote {
  id                     String       @id @default(uuid()) @db.Char(36)
  reservationId          String       @map("reservation_id") @db.Char(36)
  ratePlanId             String?      @map("rate_plan_id") @db.Char(36)
  status                 QuoteStatus  @default(DRAFT)
  calculationVersion     String       @map("calculation_version") @db.VarChar(40)
  currency               String       @default("USD") @db.Char(3)
  sellingPriceMinor      BigInt       @map("selling_price_minor")
  estimatedCostMinor     BigInt?      @map("estimated_cost_minor")
  estimatedMarginBps     Int?         @map("estimated_margin_bps")
  calculationSnapshot    Json         @map("calculation_snapshot")
  createdAt              DateTime     @default(now()) @map("created_at")
  expiresAt              DateTime?    @map("expires_at")
  reservation            Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ratePlan               RatePlan?    @relation(fields: [ratePlanId], references: [id])

  @@index([reservationId, createdAt])
  @@map("quotes")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Char(36)
  actorUserId String?   @map("actor_user_id") @db.Char(36)
  action      String    @db.VarChar(100)
  entityType  String    @map("entity_type") @db.VarChar(80)
  entityId    String?   @map("entity_id") @db.VarChar(64)
  requestId   String    @map("request_id") @db.VarChar(64)
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  actor       User?     @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
